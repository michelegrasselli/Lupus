@page "/"
@inject StanzeService Stanze
@inject ArchivioPartita Archivio
@inject ArchivioSessioni Sessioni
@inject ReteHelper Rete
@inject NavigationManager Nav

<PageTitle>Lupus · Nuova stanza</PageTitle>

<div class="setup-page">
    <header class="setup-hero">
        <div class="hero-mark">🐺</div>
        <div class="hero-copy">
            <p class="eyebrow">Lupus in Tabula · Multiplayer</p>
            <h1>Il villaggio è connesso</h1>
            <p class="hero-sub">
                Crea la stanza, mostra il codice ai giocatori e lascia che ognuno
                veda il proprio ruolo sul telefono. Il narratore conduce la notte,
                il villaggio vota dal divano.
            </p>
        </div>
        <div class="hero-stats">
            <div><strong>@Ruoli.Tutti.Count</strong><span>ruoli</span></div>
            <div><strong>@giocatori.Count</strong><span>giocatori</span></div>
            <div><strong>@Lupi</strong><span>lupi</span></div>
        </div>
    </header>

    @if (sessioni.Count > 0)
    {
        <div class="card sessions-card">
            <div class="card-head compact">
                <div>
                    <h2>Le tue stanze</h2>
                    <p class="muted small">Riprendi da dove eri rimasto su questo dispositivo.</p>
                </div>
                <span class="pill">@sessioni.Count</span>
            </div>

            <div class="session-list">
                @foreach (var sessione in sessioni)
                {
                    var stanza = Stanze.Ottieni(sessione.Codice);
                    <div class="session-row">
                        <div class="session-code">@sessione.Codice</div>
                        <div class="session-body">
                            <strong>
                                @(sessione.Tipo == TipoSessione.Host ? "Narratore" : sessione.Nome ?? "Giocatore")
                            </strong>
                            <span class="muted small">
                                @if (stanza == null)
                                {
                                    <text>Stanza scaduta o server riavviato.</text>
                                }
                                else
                                {
                                    <text>@Testi.FaseBreve(stanza.Partita.Fase) · Turno @stanza.Partita.Turno</text>
                                }
                            </span>
                        </div>
                        <div class="session-actions">
                            @if (stanza != null)
                            {
                                <button type="button" class="btn btn-primary btn-sm" @onclick="() => RiprendiSessione(sessione)">
                                    Riprendi
                                </button>
                            }
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => DimenticaSessione(sessione)">
                                Dimentica
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errore))
    {
        <div class="alert alert-error">@errore</div>
    }

    <div class="card join-card">
        <div class="card-head compact">
            <div class="card-title">
                <span class="step-number">→</span>
                <div>
                    <h2>Entra in una stanza</h2>
                    <p class="muted">Hai il codice? Inseriscilo e scegli il tuo posto.</p>
                </div>
            </div>
        </div>

        <div class="join-row">
            <input class="code-input"
                   @bind="codiceIngresso"
                   @bind:event="oninput"
                   placeholder="CODICE"
                   maxlength="8"
                   autocomplete="off"
                   aria-label="Codice stanza" />
            <button type="button" class="btn btn-primary" @onclick="Entra" disabled="@(!PuoiEntrare)">
                Cerca la stanza
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(erroreIngresso))
        {
            <p class="form-error">@erroreIngresso</p>
        }

        <p class="micro">
            I telefoni devono essere sulla stessa Wi-Fi del narratore.
            Indirizzo locale: <strong>@Rete.BaseUrl</strong>
        </p>
    </div>

    <div class="setup-grid">
        <section class="setup-main">
            <div class="card">
                <div class="card-head">
                    <div class="card-title">
                        <span class="step-number">1</span>
                        <div>
                            <h2>Chi gioca?</h2>
                            <p class="muted">
                                Si parte da zero: aggiungi un giocatore alla volta e scegli il suo ruolo.
                            </p>
                        </div>
                    </div>
                    <div class="composition-total @(giocatori.Count >= 4 ? "ok" : "ko")">
                        @giocatori.Count @(giocatori.Count == 1 ? "giocatore" : "giocatori")
                    </div>
                </div>

                <div class="draft-add">
                    <input class="draft-name"
                           @bind="nuovoNome"
                           @bind:event="oninput"
                           @onkeydown="OnNomeKeyDown"
                           placeholder="Nome del giocatore"
                           maxlength="24"
                           autocomplete="off"
                           aria-label="Nome del giocatore" />

                    <select class="role-select" @bind="nuovoRuolo" aria-label="Ruolo del giocatore">
                        @foreach (var info in Ruoli.Tutti)
                        {
                            <option value="@info.Ruolo">@info.Icona @info.Nome</option>
                        }
                    </select>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="AggiungiGiocatore"
                            disabled="@(!PuoiAggiungere)">
                        Aggiungi
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(erroreAggiunta))
                {
                    <p class="form-error">@erroreAggiunta</p>
                }

                @if (giocatori.Count == 0)
                {
                    <p class="draft-empty">
                        La tavola è vuota. Servono almeno 4 giocatori, con almeno un Lupo
                        e più non-lupi che lupi.
                    </p>
                }
                else
                {
                    <div class="draft-list">
                        @for (int i = 0; i < giocatori.Count; i++)
                        {
                            var g = giocatori[i];
                            var info = Ruoli.Info(g.Ruolo);
                            <div class="draft-player" @key="g" style="--accent: @info.Accento">
                                <span class="avatar">@Iniziali(g.Nome)</span>
                                <div class="draft-player-body">
                                    <strong>@g.Nome</strong>
                                    <span class="role-chip" style="--accent: @info.Accento">
                                        @info.Icona @info.Nome
                                    </span>
                                </div>
                                <button type="button"
                                        class="btn btn-ghost btn-sm"
                                        @onclick="() => RimuoviGiocatore(i)"
                                        aria-label="Rimuovi @g.Nome">
                                    Rimuovi
                                </button>
                            </div>
                        }
                    </div>
                }

                <p class="micro">
                    Ogni giocatore diventa un posto da reclamare dal telefono.
                    Il ruolo resta segreto finché non avvii la partita.
                </p>
            </div>
        </section>

        <aside class="setup-aside">
            <div class="card summary-card">
                <h2>Riepilogo</h2>

                <div class="summary-row"><span>Giocatori</span><strong>@giocatori.Count</strong></div>
                <div class="summary-row"><span>Lupi</span><strong class="evil">@Lupi</strong></div>
                <div class="summary-row"><span>Non lupi</span><strong class="good">@Altri</strong></div>

                @if (giocatori.Count > 0)
                {
                    <div class="composition-bar" aria-hidden="true">
                        <div class="bar-wolves" style="width: @PercentualeLupi%"></div>
                        <div class="bar-others" style="width: @(100 - PercentualeLupi)%"></div>
                    </div>

                    <div class="composition-pills">
                        @foreach (var info in Ruoli.Tutti.Where(x => Quantita(x.Ruolo) > 0))
                        {
                            <span class="composition-pill" style="--accent: @info.Accento">
                                @info.Icona @info.Nome <strong>×@Quantita(info.Ruolo)</strong>
                            </span>
                        }
                    </div>
                }

                @if (giocatori.Count == 0)
                {
                    <div class="validation">Aggiungi almeno 4 giocatori per creare la stanza.</div>
                }
                else if (Errori.Count == 0)
                {
                    <div class="validation ok">Tutto pronto. La stanza può nascere.</div>
                }
                else
                {
                    <ul class="validation ko">
                        @foreach (var e in Errori)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }

                <button type="button" class="btn btn-primary btn-block" @onclick="CreaStanza" disabled="@(!PuoiCreare)">
                    Crea la stanza
                </button>
                <p class="micro">
                    Riceverai un codice a 5 lettere e un link per i telefoni.
                    La partita vive sul server: niente salvataggi da passare.
                </p>
            </div>

            <div class="card info-card">
                <h3>Come funziona</h3>
                <ol class="how-list">
                    <li>Aggiungi i giocatori e scegli il ruolo di ciascuno.</li>
                    <li>I giocatori aprono il link e reclamano il proprio posto.</li>
                    <li>Avvia la partita: ognuno vede il ruolo solo sul proprio telefono.</li>
                    <li>La notte i poteri si scelgono dal telefono; il narratore vede tutto.</li>
                    <li>Il voto del rogo si raccoglie dal vivo, con conteggio in tempo reale.</li>
                </ol>
            </div>

            <div class="card info-card">
                <h3>Riprendi un salvataggio</h3>
                <p class="muted small">
                    Un JSON esportato da una partita precedente può diventare una nuova stanza.
                    I posti restano liberi: i giocatori dovranno rientrare.
                </p>
                <label class="btn btn-ghost btn-block file-btn">
                    @(importInCorso ? "Importazione..." : "Importa JSON")
                    <InputFile OnChange="ImportaAsync" accept=".json,application/json" />
                </label>
            </div>
        </aside>
    </div>
</div>

@code {
    private sealed class BozzaGiocatore
    {
        public string Nome { get; set; } = "";
        public Ruolo Ruolo { get; set; }
    }

    private const int MassimoGiocatori = 30;

    private List<BozzaGiocatore> giocatori = new();
    private string nuovoNome = "";
    private Ruolo nuovoRuolo = Ruolo.Contadino;
    private string? erroreAggiunta;
    private string? errore;
    private string? erroreIngresso;
    private string codiceIngresso = "";
    private bool importInCorso;
    private List<SessioneBrowser> sessioni = new();

    private int Totale => giocatori.Count;
    private int Lupi => giocatori.Count(g => g.Ruolo == Ruolo.Lupo);
    private int Altri => Totale - Lupi;
    private int PercentualeLupi => Totale == 0 ? 0 : (int)Math.Round(100.0 * Lupi / Totale);
    private bool PuoiEntrare => codiceIngresso.Trim().Length >= 4;
    private bool PuoiAggiungere =>
        !string.IsNullOrWhiteSpace(nuovoNome) && giocatori.Count < MassimoGiocatori;

    private Dictionary<Ruolo, int> Composizione =>
        giocatori.GroupBy(g => g.Ruolo).ToDictionary(g => g.Key, g => g.Count());

    private List<string> Errori =>
        CreazionePartita.Valida(Totale, Composizione, giocatori.Select(g => g.Nome).ToList());

    private bool PuoiCreare => Errori.Count == 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await CaricaSessioniAsync();
        StateHasChanged();
    }

    private async Task CaricaSessioniAsync()
    {
        var tutte = await Sessioni.CaricaAsync();
        sessioni = tutte
            .Where(s => Stanze.Ottieni(s.Codice) != null)
            .OrderByDescending(s => s.SalvataIl)
            .ToList();

        // Rimuove i riferimenti a stanze che il server non ha più.
        foreach (var scaduta in tutte.Except(sessioni))
            await Sessioni.RimuoviAsync(scaduta.Codice, scaduta.Tipo);
    }

    private int Quantita(Ruolo ruolo) => giocatori.Count(g => g.Ruolo == ruolo);

    private void AggiungiGiocatore()
    {
        erroreAggiunta = null;
        var nome = nuovoNome.Trim();

        if (string.IsNullOrWhiteSpace(nome))
        {
            erroreAggiunta = "Inserisci il nome del giocatore.";
            return;
        }

        if (giocatori.Any(g => string.Equals(g.Nome.Trim(), nome, StringComparison.OrdinalIgnoreCase)))
        {
            erroreAggiunta = $"C'è già un giocatore che si chiama {nome}.";
            return;
        }

        if (giocatori.Count >= MassimoGiocatori)
        {
            erroreAggiunta = $"Hai raggiunto il massimo di {MassimoGiocatori} giocatori.";
            return;
        }

        giocatori.Add(new BozzaGiocatore { Nome = nome, Ruolo = nuovoRuolo });
        nuovoNome = "";
        errore = null;
    }

    private void RimuoviGiocatore(int indice)
    {
        if (indice < 0 || indice >= giocatori.Count) return;

        giocatori.RemoveAt(indice);
        erroreAggiunta = null;
        errore = null;
    }

    private void OnNomeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && PuoiAggiungere)
            AggiungiGiocatore();
    }

    private static string Iniziali(string nome)
    {
        var parti = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parti.Length == 0) return "?";
        if (parti.Length == 1)
            return parti[0][..Math.Min(2, parti[0].Length)].ToUpperInvariant();

        return $"{parti[0][0]}{parti[^1][0]}".ToUpperInvariant();
    }

    private async Task CreaStanza()
    {
        errore = null;

        if (Errori.Count > 0)
        {
            errore = Errori[0];
            return;
        }

        try
        {
            var (stanza, hostToken) = Stanze.CreaDaRuoli(
                giocatori.Select(g => (g.Nome.Trim(), g.Ruolo)).ToList());

            await Sessioni.SalvaAsync(new SessioneBrowser
            {
                Codice = stanza.Codice,
                Tipo = TipoSessione.Host,
                Token = hostToken
            });

            Nav.NavigateTo($"/partita/{stanza.Codice}?h={hostToken}");
        }
        catch (Exception ex)
        {
            errore = ex.Message;
        }
    }

    private void Entra()
    {
        erroreIngresso = null;
        var codice = codiceIngresso.Trim().ToUpperInvariant();

        if (codice.Length < 4)
        {
            erroreIngresso = "Inserisci il codice della stanza.";
            return;
        }

        if (Stanze.Ottieni(codice) == null)
        {
            erroreIngresso = "Nessuna stanza con questo codice. Controlla e riprova.";
            return;
        }

        Nav.NavigateTo($"/entra/{codice}");
    }

    private void RiprendiSessione(SessioneBrowser sessione)
    {
        if (sessione.Tipo == TipoSessione.Host)
            Nav.NavigateTo($"/partita/{sessione.Codice}?h={sessione.Token}");
        else
            Nav.NavigateTo($"/gioca/{sessione.Codice}?t={sessione.Token}");
    }

    private async Task DimenticaSessione(SessioneBrowser sessione)
    {
        if (sessione.Tipo == TipoSessione.Giocatore &&
            Stanze.Ottieni(sessione.Codice) is { } stanza)
        {
            await Stanze.LasciaPostoAsync(stanza, sessione.Token);
        }

        await Sessioni.RimuoviAsync(sessione.Codice, sessione.Tipo);
        await CaricaSessioniAsync();
    }

    private async Task ImportaAsync(InputFileChangeEventArgs e)
    {
        errore = null;
        importInCorso = true;

        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 5_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var importata = Serializzazione.Deserializza(json);
            if (importata == null || importata.Giocatori.Count == 0)
            {
                errore = "Il file non contiene una partita valida.";
                return;
            }

            var avviata = importata.Fase != FasePartita.NotteIntro;
            var (stanza, hostToken) = Stanze.CreaDaPartita(importata, avviata);

            await Sessioni.SalvaAsync(new SessioneBrowser
            {
                Codice = stanza.Codice,
                Tipo = TipoSessione.Host,
                Token = hostToken
            });

            Nav.NavigateTo($"/partita/{stanza.Codice}?h={hostToken}");
        }
        catch (Exception ex)
        {
            errore = $"Import non riuscito: {ex.Message}";
        }
        finally
        {
            importInCorso = false;
        }
    }
}
