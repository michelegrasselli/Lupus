@page "/"
@inject StanzeService Stanze
@inject ArchivioPartita Archivio
@inject ArchivioSessioni Sessioni
@inject ReteHelper Rete
@inject NavigationManager Nav

<PageTitle>Lupus · Nuova stanza</PageTitle>

<div class="setup-page">
    <header class="setup-hero">
        <div class="hero-mark">🐺</div>
        <div class="hero-copy">
            <p class="eyebrow">Lupus in Tabula · Multiplayer</p>
            <h1>Il villaggio è connesso</h1>
            <p class="hero-sub">
                Crea la stanza, mostra il codice ai giocatori e lascia che ognuno
                veda il proprio ruolo sul telefono. Il narratore conduce la notte,
                il villaggio vota dal divano.
            </p>
        </div>
        <div class="hero-stats">
            <div><strong>@Ruoli.Tutti.Count</strong><span>ruoli</span></div>
            <div><strong>@Preset.Tutti.Count</strong><span>preset</span></div>
            <div><strong>@numeroGiocatori</strong><span>posti</span></div>
        </div>
    </header>

    @if (sessioni.Count > 0)
    {
        <div class="card sessions-card">
            <div class="card-head compact">
                <div>
                    <h2>Le tue stanze</h2>
                    <p class="muted small">Riprendi da dove eri rimasto su questo dispositivo.</p>
                </div>
                <span class="pill">@sessioni.Count</span>
            </div>

            <div class="session-list">
                @foreach (var sessione in sessioni)
                {
                    var stanza = Stanze.Ottieni(sessione.Codice);
                    <div class="session-row">
                        <div class="session-code">@sessione.Codice</div>
                        <div class="session-body">
                            <strong>
                                @(sessione.Tipo == TipoSessione.Host ? "Narratore" : sessione.Nome ?? "Giocatore")
                            </strong>
                            <span class="muted small">
                                @if (stanza == null)
                                {
                                    <text>Stanza scaduta o server riavviato.</text>
                                }
                                else
                                {
                                    <text>@Testi.FaseBreve(stanza.Partita.Fase) · Turno @stanza.Partita.Turno</text>
                                }
                            </span>
                        </div>
                        <div class="session-actions">
                            @if (stanza != null)
                            {
                                <button type="button" class="btn btn-primary btn-sm" @onclick="() => RiprendiSessione(sessione)">
                                    Riprendi
                                </button>
                            }
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => DimenticaSessione(sessione)">
                                Dimentica
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errore))
    {
        <div class="alert alert-error">@errore</div>
    }

    <div class="card join-card">
        <div class="card-head compact">
            <div class="card-title">
                <span class="step-number">→</span>
                <div>
                    <h2>Entra in una stanza</h2>
                    <p class="muted">Hai il codice? Inseriscilo e scegli il tuo posto.</p>
                </div>
            </div>
        </div>

        <div class="join-row">
            <input class="code-input"
                   @bind="codiceIngresso"
                   @bind:event="oninput"
                   placeholder="CODICE"
                   maxlength="8"
                   autocomplete="off"
                   aria-label="Codice stanza" />
            <button type="button" class="btn btn-primary" @onclick="Entra" disabled="@(!PuoiEntrare)">
                Cerca la stanza
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(erroreIngresso))
        {
            <p class="form-error">@erroreIngresso</p>
        }

        <p class="micro">
            I telefoni devono essere sulla stessa Wi-Fi del narratore.
            Indirizzo locale: <strong>@Rete.BaseUrl</strong>
        </p>
    </div>

    <div class="setup-grid">
        <section class="setup-main">
            <div class="card">
                <div class="card-head">
                    <div class="card-title">
                        <span class="step-number">1</span>
                        <div>
                            <h2>Quanti giocatori?</h2>
                            <p class="muted">Scegli un preset o imposta il numero manualmente.</p>
                        </div>
                    </div>
                    <div class="player-count">
                        <button type="button" class="icon-btn" @onclick="() => CambiaNumero(-1)" aria-label="Riduci giocatori">−</button>
                        <input type="number" min="4" max="30" value="@numeroGiocatori" @onchange="OnNumeroChanged" aria-label="Numero di giocatori" />
                        <button type="button" class="icon-btn" @onclick="() => CambiaNumero(1)" aria-label="Aumenta giocatori">+</button>
                    </div>
                </div>

                <div class="preset-row">
                    @foreach (var preset in Preset.Tutti)
                    {
                        <button type="button"
                                class="preset-card @(presetAttivo == preset.Nome ? "active" : "")"
                                @onclick="() => ApplicaPreset(preset)">
                            <strong>@preset.Nome</strong>
                            <span>@preset.Descrizione</span>
                            <em>@preset.Totale giocatori</em>
                        </button>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div class="card-title">
                        <span class="step-number">2</span>
                        <div>
                            <h2>Composizione dei ruoli</h2>
                            <p class="muted">Almeno un Lupo e più non-lupi che Lupi.</p>
                        </div>
                    </div>
                    <div class="composition-total @(TotaleRuoli == numeroGiocatori ? "ok" : "ko")">
                        @TotaleRuoli / @numeroGiocatori
                    </div>
                </div>

                <div class="role-grid">
                    @foreach (var info in Ruoli.Tutti)
                    {
                        var quantita = Quantita(info.Ruolo);
                        <div class="role-card @(quantita > 0 ? "has-count" : "")" style="--accent: @info.Accento">
                            <div class="role-card-icon">@info.Icona</div>
                            <div class="role-card-body">
                                <div class="role-card-title">
                                    <strong>@info.Nome</strong>
                                    <span class="alignment @(info.Buono ? "good" : "evil")">
                                        @(info.Buono ? "Buono" : "Cattivo")
                                    </span>
                                </div>
                                <p>@info.Descrizione</p>
                            </div>
                            <div class="role-counter">
                                <button type="button" class="icon-btn" @onclick="() => CambiaRuolo(info.Ruolo, -1)"
                                        disabled="@(quantita == 0)" aria-label="Rimuovi @info.Nome">−</button>
                                <span>@quantita</span>
                                <button type="button" class="icon-btn" @onclick="() => CambiaRuolo(info.Ruolo, 1)"
                                        aria-label="Aggiungi @info.Nome">+</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div class="card-title">
                        <span class="step-number">3</span>
                        <div>
                            <h2>Nomi dei giocatori</h2>
                            <p class="muted">I nomi devono essere unici. Ogni nome diventa un posto da reclamare.</p>
                        </div>
                    </div>
                    <div class="head-actions">
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="GeneraNomi">Genera nomi</button>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="PulisciNomi">Svuota</button>
                    </div>
                </div>

                <div class="names-grid">
                    @for (int i = 0; i < nomi.Count; i++)
                    {
                        var entry = nomi[i];
                        <label class="name-field" @key="entry">
                            <span>@(i + 1)</span>
                            <input @bind="entry.Nome" placeholder="Nome giocatore" maxlength="24" autocomplete="off" />
                        </label>
                    }
                </div>

                <label class="toggle">
                    <input type="checkbox" @bind="assegnaCasualmente" />
                    <span>Assegna i ruoli casualmente</span>
                </label>
            </div>
        </section>

        <aside class="setup-aside">
            <div class="card summary-card">
                <h2>Riepilogo</h2>

                <div class="summary-row"><span>Giocatori</span><strong>@numeroGiocatori</strong></div>
                <div class="summary-row"><span>Ruoli scelti</span><strong>@TotaleRuoli</strong></div>
                <div class="summary-row"><span>Lupi</span><strong class="evil">@Lupi</strong></div>
                <div class="summary-row"><span>Non lupi</span><strong class="good">@Altri</strong></div>

                <div class="composition-bar" aria-hidden="true">
                    <div class="bar-wolves" style="width: @PercentualeLupi%"></div>
                    <div class="bar-others" style="width: @(100 - PercentualeLupi)%"></div>
                </div>

                @if (Errori.Count == 0)
                {
                    <div class="validation ok">Tutto pronto. La stanza può nascere.</div>
                }
                else
                {
                    <ul class="validation ko">
                        @foreach (var e in Errori)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }

                <button type="button" class="btn btn-primary btn-block" @onclick="CreaStanza" disabled="@(!PuoiCreare)">
                    Crea la stanza
                </button>
                <p class="micro">
                    Riceverai un codice a 5 lettere e un link per i telefoni.
                    La partita vive sul server: niente salvataggi da passare.
                </p>
            </div>

            <div class="card info-card">
                <h3>Come funziona</h3>
                <ol class="how-list">
                    <li>Crea la stanza con ruoli e nomi.</li>
                    <li>I giocatori aprono il link e reclamano il proprio posto.</li>
                    <li>Avvia la partita: ognuno vede il ruolo solo sul proprio telefono.</li>
                    <li>La notte i poteri si scelgono dal telefono; il narratore vede tutto.</li>
                    <li>Il voto del rogo si raccoglie dal vivo, con conteggio in tempo reale.</li>
                </ol>
            </div>

            <div class="card info-card">
                <h3>Riprendi un salvataggio</h3>
                <p class="muted small">
                    Un JSON esportato da una partita precedente può diventare una nuova stanza.
                    I posti restano liberi: i giocatori dovranno rientrare.
                </p>
                <label class="btn btn-ghost btn-block file-btn">
                    @(importInCorso ? "Importazione..." : "Importa JSON")
                    <InputFile OnChange="ImportaAsync" accept=".json,application/json" />
                </label>
            </div>
        </aside>
    </div>
</div>

@code {
    private sealed class NomeEntry
    {
        public string Nome { get; set; } = "";
    }

    private int numeroGiocatori = 8;
    private Dictionary<Ruolo, int> composizione = new();
    private List<NomeEntry> nomi = new();
    private bool assegnaCasualmente = true;
    private string? presetAttivo;
    private string? errore;
    private string? erroreIngresso;
    private string codiceIngresso = "";
    private bool importInCorso;
    private List<SessioneBrowser> sessioni = new();

    private int TotaleRuoli => composizione.Values.Sum();
    private int Lupi => Quantita(Ruolo.Lupo);
    private int Altri => TotaleRuoli - Lupi;
    private int PercentualeLupi => TotaleRuoli == 0 ? 0 : (int)Math.Round(100.0 * Lupi / TotaleRuoli);
    private bool PuoiEntrare => codiceIngresso.Trim().Length >= 4;

    private List<string> Errori =>
        CreazionePartita.Valida(numeroGiocatori, composizione, nomi.Select(n => n.Nome).ToList());

    private bool PuoiCreare => Errori.Count == 0;

    protected override void OnInitialized()
    {
        var preset = Preset.Tutti.FirstOrDefault(p => p.Totale == 8) ?? Preset.Tutti[0];
        ApplicaPreset(preset);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await CaricaSessioniAsync();
        StateHasChanged();
    }

    private async Task CaricaSessioniAsync()
    {
        var tutte = await Sessioni.CaricaAsync();
        sessioni = tutte
            .Where(s => Stanze.Ottieni(s.Codice) != null)
            .OrderByDescending(s => s.SalvataIl)
            .ToList();

        // Rimuove i riferimenti a stanze che il server non ha più.
        foreach (var scaduta in tutte.Except(sessioni))
            await Sessioni.RimuoviAsync(scaduta.Codice, scaduta.Tipo);
    }

    private int Quantita(Ruolo ruolo) => composizione.GetValueOrDefault(ruolo);

    private void ApplicaPreset(PresetPartita preset)
    {
        numeroGiocatori = preset.Totale;
        composizione = new Dictionary<Ruolo, int>(preset.Ruoli);
        AggiornaNomi();
        presetAttivo = preset.Nome;
        errore = null;
    }

    private void CambiaNumero(int delta)
    {
        numeroGiocatori = Math.Clamp(numeroGiocatori + delta, 4, 30);
        AggiornaNomi();
    }

    private void OnNumeroChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var valore))
            numeroGiocatori = Math.Clamp(valore, 4, 30);
        else
            numeroGiocatori = Math.Clamp(numeroGiocatori, 4, 30);

        AggiornaNomi();
    }

    private void AggiornaNomi()
    {
        numeroGiocatori = Math.Clamp(numeroGiocatori, 4, 30);

        while (nomi.Count < numeroGiocatori)
            nomi.Add(new NomeEntry { Nome = $"Giocatore {nomi.Count + 1}" });

        while (nomi.Count > numeroGiocatori)
            nomi.RemoveAt(nomi.Count - 1);

        presetAttivo = null;
    }

    private void CambiaRuolo(Ruolo ruolo, int delta)
    {
        var attuale = Quantita(ruolo);
        composizione[ruolo] = Math.Max(0, attuale + delta);
        presetAttivo = null;
        errore = null;
    }

    private void GeneraNomi()
    {
        for (int i = 0; i < nomi.Count; i++)
            nomi[i].Nome = $"Giocatore {i + 1}";
    }

    private void PulisciNomi()
    {
        foreach (var entry in nomi)
            entry.Nome = "";
    }

    private async Task CreaStanza()
    {
        errore = null;

        if (Errori.Count > 0)
        {
            errore = Errori[0];
            return;
        }

        try
        {
            var (stanza, hostToken) = Stanze.Crea(
                nomi.Select(n => n.Nome.Trim()).ToList(),
                composizione,
                assegnaCasualmente);

            await Sessioni.SalvaAsync(new SessioneBrowser
            {
                Codice = stanza.Codice,
                Tipo = TipoSessione.Host,
                Token = hostToken
            });

            Nav.NavigateTo($"/partita/{stanza.Codice}?h={hostToken}");
        }
        catch (Exception ex)
        {
            errore = ex.Message;
        }
    }

    private void Entra()
    {
        erroreIngresso = null;
        var codice = codiceIngresso.Trim().ToUpperInvariant();

        if (codice.Length < 4)
        {
            erroreIngresso = "Inserisci il codice della stanza.";
            return;
        }

        if (Stanze.Ottieni(codice) == null)
        {
            erroreIngresso = "Nessuna stanza con questo codice. Controlla e riprova.";
            return;
        }

        Nav.NavigateTo($"/entra/{codice}");
    }

    private void RiprendiSessione(SessioneBrowser sessione)
    {
        if (sessione.Tipo == TipoSessione.Host)
            Nav.NavigateTo($"/partita/{sessione.Codice}?h={sessione.Token}");
        else
            Nav.NavigateTo($"/gioca/{sessione.Codice}?t={sessione.Token}");
    }

    private async Task DimenticaSessione(SessioneBrowser sessione)
    {
        if (sessione.Tipo == TipoSessione.Giocatore &&
            Stanze.Ottieni(sessione.Codice) is { } stanza)
        {
            await Stanze.LasciaPostoAsync(stanza, sessione.Token);
        }

        await Sessioni.RimuoviAsync(sessione.Codice, sessione.Tipo);
        await CaricaSessioniAsync();
    }

    private async Task ImportaAsync(InputFileChangeEventArgs e)
    {
        errore = null;
        importInCorso = true;

        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 5_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var importata = Serializzazione.Deserializza(json);
            if (importata == null || importata.Giocatori.Count == 0)
            {
                errore = "Il file non contiene una partita valida.";
                return;
            }

            var avviata = importata.Fase != FasePartita.NotteIntro;
            var (stanza, hostToken) = Stanze.CreaDaPartita(importata, avviata);

            await Sessioni.SalvaAsync(new SessioneBrowser
            {
                Codice = stanza.Codice,
                Tipo = TipoSessione.Host,
                Token = hostToken
            });

            Nav.NavigateTo($"/partita/{stanza.Codice}?h={hostToken}");
        }
        catch (Exception ex)
        {
            errore = $"Import non riuscito: {ex.Message}";
        }
        finally
        {
            importInCorso = false;
        }
    }
}
