    private async Task ChiudiVoto(string? scelta)
    {
        if (stanza == null) return;

        errore = null;
        try
        {
            var risultato = await Stanze.ChiudiVotoAsync(stanza, hostToken!, scelta);
            if (!risultato.Ok)
            {
                errore = risultato.Errore;
            }
            else
            {
                avviso = risultato.Messaggio;
                selezionatoId = null;
            }
        }
        finally
        {
            AggiornaVista();
            StateHasChanged();
        }
    }

