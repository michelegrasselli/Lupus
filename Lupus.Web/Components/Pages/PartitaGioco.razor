@page "/partita/{Codice}"
@implements IDisposable
@inject StanzeService Stanze
@inject ArchivioSessioni Sessioni
@inject ArchivioPartita Archivio
@inject ReteHelper Rete
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Lupus · @TitoloPagina</PageTitle>

@if (caricamento)
{
    <div class="loading-page">
        <div class="spinner" aria-hidden="true"></div>
        <p>Preparo la stanza...</p>
    </div>
}
else if (stanza == null)
{
    <div class="empty-page">
        <div class="empty-icon">🌫️</div>
        <h1>Stanza non trovata</h1>
        <p class="muted">
            Il codice <strong>@Codice</strong> non esiste più, oppure il server è stato riavviato.
        </p>
        <div class="empty-actions">
            <a class="btn btn-primary" href="/">Torna alla home</a>
        </div>
    </div>
}
else if (accessoNegato)
{
    <div class="empty-page">
        <div class="empty-icon">🔐</div>
        <h1>Token narratore mancante</h1>
        <p class="muted">
            Apri questa stanza dal link del narratore salvato su questo dispositivo,
            oppure crea una nuova stanza dalla home.
        </p>
        <div class="empty-actions">
            <a class="btn btn-primary" href="/">Torna alla home</a>
        </div>
    </div>
}
else
{
    var p = stanza.Partita;

    <div class="game-page">
        <header class="game-header">
            <div class="game-brand">
                <span class="brand-mark" aria-hidden="true">🐺</span>
                <div>
                    <p class="eyebrow">Stanza @stanza.Codice · Narratore</p>
                    <h1>@TitoloFase</h1>
                    <p class="muted small">@SottotitoloFase</p>
                </div>
            </div>

            <div class="game-meta">
                <span class="pill">Turno @p.Turno</span>
                <span class="pill good">@p.AltriViviCount buoni</span>
                <span class="pill evil">@p.LupiViviCount lupi</span>
                <span class="pill">@p.TotaleVivi vivi</span>
            </div>

            <div class="game-actions">
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ApriModaleRuoli">Rivela ruoli</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleMostraRuoli">
                    @(mostraRuoli ? "Nascondi ruoli" : "Mostra ruoli")
                </button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="Esporta">Esporta</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ChiudiStanza">Chiudi</button>
            </div>
        </header>

        <nav class="phase-timeline" aria-label="Fasi della partita">
            @foreach (var fase in Fasi)
            {
                <span class="phase-step @ClasseFase(fase)">
                    <span class="phase-dot" aria-hidden="true"></span>
                    @Testi.FaseBreve(fase)
                </span>
            }
        </nav>

        @if (!string.IsNullOrWhiteSpace(errore))
        {
            <div class="alert alert-error">
                <span>@errore</span>
                <button type="button" class="alert-close" @onclick="() => errore = null" aria-label="Chiudi messaggio">✕</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(avviso))
        {
            <div class="alert alert-info">
                <span>@avviso</span>
                <button type="button" class="alert-close" @onclick="() => avviso = null" aria-label="Chiudi messaggio">✕</button>
            </div>
        }

        <div class="game-grid">
            <main class="game-main">
                @if (!stanza.Avviata)
                {
                    <div class="card lobby-card">
                        <div class="stage-head">
                            <div class="stage-icon">🏠</div>
                            <div>
                                <p class="eyebrow">Stanza @stanza.Codice</p>
                                <h2>La tavola è pronta</h2>
                                <p class="muted">Fai entrare i giocatori dai loro telefoni, poi avvia la partita.</p>
                            </div>
                        </div>

                        <div class="join-banner">
                            <div class="join-banner-main">
                                <span class="join-label">Codice</span>
                                <strong class="join-code">@stanza.Codice</strong>
                            </div>
                            <div class="join-banner-url">
                                <span class="join-label">Link per i telefoni</span>
                                <code>@JoinUrl</code>
                            </div>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="CopiaLink">Copia link</button>
                        </div>

                        <div class="lobby-progress">
                            <span>@posti.Count(x => x.Occupato) / @posti.Count posti occupati</span>
                            <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@posti.Count" aria-valuenow="@posti.Count(x => x.Occupato)">
                                <div style="width: @Percentuale(posti.Count(x => x.Occupato), posti.Count)%"></div>
                            </div>
                        </div>

                        <div class="lobby-seats">
                            @foreach (var posto in posti)
                            {
                                <div class="lobby-seat @(posto.Occupato ? "ready" : "")">
                                    <span class="avatar">@posto.Iniziali</span>
                                    <div class="lobby-seat-body">
                                        <strong>@posto.Nome</strong>
                                        <span>@(posto.Occupato ? "connesso" : "in attesa")</span>
                                    </div>
                                    @if (posto.Occupato)
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => LiberaPosto(posto.GiocatoreId)">
                                            Libera
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="stage-actions">
                            <button type="button" class="btn btn-primary" @onclick="AvviaStanza">
                                Avvia la partita
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="ApriModaleRuoli">
                                Controlla i ruoli
                            </button>
                        </div>

                        <p class="micro">
                            Puoi avviare anche se manca qualcuno: potrà entrare dopo.
                            I ruoli restano nascosti sui telefoni finché non avvii.
                        </p>
                    </div>
                }
                else if (p.Fase == FasePartita.NotteIntro)
                {
                    <div class="card intro-card">
                        <div class="stage-head">
                            <div class="stage-icon">🌙</div>
                            <div>
                                <p class="eyebrow">Turno @p.Turno</p>
                                <h2>Preparazione della notte</h2>
                                <p class="muted">I telefoni mostrano già il ruolo. Chiama il villaggio a dormire.</p>
                            </div>
                        </div>

                        <div class="composition-pills">
                            @foreach (var gruppo in Composizione.OrderBy(g => Ruoli.Info(g.Key).Priorita))
                            {
                                var info = Ruoli.Info(gruppo.Key);
                                <span class="composition-pill" style="--accent: @info.Accento">
                                    @info.Icona @info.Nome <strong>x@(gruppo.Count())</strong>
                                </span>
                            }
                        </div>

                        <div class="stage-actions">
                            <button type="button" class="btn btn-ghost" @onclick="ApriModaleRuoli">Rivela i ruoli</button>
                            <button type="button" class="btn btn-primary" @onclick="IniziaNotte">Inizia la notte</button>
                        </div>

                        <div class="narrator-box">
                            <strong>Solo narratore</strong>
                            <p>Composizione: @ComposizioneTesto</p>
                            @if (p.Capobranco is { } capo)
                            {
                                <p>Capobranco: @capo.Nome</p>
                            }
                            <p>Lupi vivi: @p.LupiViviCount · Non lupi vivi: @p.AltriViviCount</p>
                        </div>
                    </div>
                }
                else if (p.Fase == FasePartita.Notte)
                {
                    @if (p.PassoCorrente is { } passo)
                    {
                        <div class="card step-card">
                            <div class="step-progress">
                                <span>Passo @(PassiCompletati + 1) di @PassiTotali</span>
                                <div class="step-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@PassiTotali" aria-valuenow="@PassiCompletati">
                                    <div style="width: @PercentualePassi%"></div>
                                </div>
                            </div>

                            <div class="stage-head">
                                <div class="stage-icon">@IconaPasso(passo)</div>
                                <div>
                                    <p class="eyebrow">@(passo.Tipo == TipoPasso.Capobranco ? "Elezioni" : "Azione notturna")</p>
                                    <h2>@passo.Titolo</h2>
                                    <p class="muted">@passo.Istruzione</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(passo.Risultato) && !passo.Completato)
                            {
                                <div class="result-panel">
                                    <strong>Risultato</strong>
                                    <p>@passo.Risultato</p>
                                </div>
                                <div class="stage-actions">
                                    <button type="button" class="btn btn-primary" @onclick="ConfermaRisultatoNarratore">
                                        Conferma e prosegui
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="muted small step-actor">
                                    @AttorePasso(passo) Il giocatore può agire dal telefono;
                                    in alternativa scegli tu il bersaglio qui.
                                </p>

                                <PlayerPicker Giocatori="GiocatoriPasso"
                                              SelezionatoId="@selezionatoId"
                                              OnSeleziona="Seleziona"
                                              MostraRuoli="mostraRuoli" />

                                <div class="stage-actions">
                                    <button type="button" class="btn btn-primary" @onclick="EseguiPassoNarratore" disabled="@(selezionatoId == null)">
                                        Conferma scelta
                                    </button>
                                    @if (passo.Tipo == TipoPasso.Capobranco)
                                    {
                                        <span class="muted small">Scegli un Lupo vivo: sarà il nuovo capobranco.</span>
                                    }
                                    else if (selezionatoId != null)
                                    {
                                        <span class="muted small">Bersaglio: <strong>@p.NomeDi(selezionatoId)</strong></span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="card complete-card">
                            <div class="stage-head">
                                <div class="stage-icon">🌙</div>
                                <div>
                                    <p class="eyebrow">Notte @p.Turno</p>
                                    <h2>Tutte le azioni sono registrate</h2>
                                    <p class="muted">Controlla il riepilogo e risolvi la notte.</p>
                                </div>
                            </div>
                            <div class="stage-actions">
                                <button type="button" class="btn btn-primary" @onclick="RisolviNotte">Risolvi la notte</button>
                            </div>
                        </div>
                    }

                    <div class="card night-log-card">
                        <div class="card-head compact">
                            <h2>Azioni di questa notte</h2>
                            <span class="muted">@PassiCompletati / @PassiTotali</span>
                        </div>

                        @if (p.PassiNotte.Count == 0)
                        {
                            <p class="empty-state">Nessuna azione prevista per questa notte.</p>
                        }
                        else
                        {
                            <div class="step-list">
                                @foreach (var s in p.PassiNotte)
                                {
                                    <div class="step-row @(s.Completato ? "done" : s == p.PassoCorrente ? "current" : "todo")">
                                        <span class="step-row-icon">@IconaPasso(s)</span>
                                        <div class="step-row-body">
                                            <strong>@s.Titolo</strong>
                                            @if (!string.IsNullOrWhiteSpace(s.Risultato))
                                            {
                                                <p>@s.Risultato</p>
                                            }
                                            else
                                            {
                                                <p class="muted">@(s.Completato ? "Completato" : s == p.PassoCorrente ? ToccaA(s) : "In attesa")</p>
                                            }
                                        </div>
                                        <span class="step-row-state" aria-hidden="true">@(s.Completato ? "✓" : s == p.PassoCorrente ? "▶" : "…")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else if (p.Fase == FasePartita.Alba)
                {
                    <div class="card dawn-card">
                        <div class="stage-head">
                            <div class="stage-icon">🌅</div>
                            <div>
                                <p class="eyebrow">Turno @p.Turno</p>
                                <h2>Alba</h2>
                                <p class="muted">Annuncia al villaggio cosa è successo stanotte.</p>
                            </div>
                        </div>

                        @if (Risultato == null)
                        {
                            <p class="muted">Nessun report disponibile per questa notte.</p>
                        }
                        else
                        {
                            <div class="dawn-events">
                                @foreach (var ev in EventiPubblici)
                                {
                                    <div class="event-row">@ev.Testo</div>
                                }
                            </div>

                            @if (MortiNotte.Count > 0)
                            {
                                <h3 class="section-title">I caduti della notte</h3>
                                <div class="dawn-deaths">
                                    @foreach (var morto in MortiNotte)
                                    {
                                        <div class="death-card" style="--accent: @Ruoli.Info(morto.Ruolo).Accento">
                                            <span class="avatar">@morto.Iniziali</span>
                                            <div>
                                                <strong>@morto.Nome</strong>
                                                <span class="role-chip" style="--accent: @Ruoli.Info(morto.Ruolo).Accento">
                                                    @Ruoli.Info(morto.Ruolo).Icona @Ruoli.Nome(morto.Ruolo)
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (Gufati.Count > 0)
                            {
                                <div class="info-banner">
                                    🦉 Il Gufo ha mandato al ballottaggio: <strong>@NomiGufati</strong>.
                                </div>
                            }

                            @if (EventiRiservati.Any())
                            {
                                <div class="narrator-box">
                                    <strong>Solo narratore</strong>
                                    @foreach (var ev in EventiRiservati)
                                    {
                                        <p>@ev.Testo</p>
                                    }
                                </div>
                            }
                        }

                        <label class="toggle">
                            <input type="checkbox"
                                   checked="@stanza.RivelaRuoliMorti"
                                   @onchange="OnRivelaRuoliMortiChanged" />
                            <span>Rivela ai telefoni i ruoli dei caduti</span>
                        </label>

                        <div class="stage-actions">
                            <button type="button" class="btn btn-primary" @onclick="VaiAlGiorno">
                                @(p.Esito == null ? "Vai alla discussione" : "Vedi il risultato finale")
                            </button>
                        </div>
                    </div>
                }
                else if (p.Fase == FasePartita.Giorno)
                {
                    <div class="card">
                        <div class="stage-head">
                            <div class="stage-icon">☀️</div>
                            <div>
                                <p class="eyebrow">Turno @p.Turno</p>
                                <h2>Il villaggio discute</h2>
                                <p class="muted">Ascolta gli accusi, gestisci il timer e quando siete pronti aprite il voto.</p>
                            </div>
                        </div>

                        <div class="alive-strip">
                            @foreach (var g in GiocatoriVivi)
                            {
                                <span class="alive-chip" style="--accent: @Ruoli.Info(g.Ruolo).Accento">
                                    <span class="avatar">@g.Iniziali</span>
                                    @g.Nome
                                    @if (g.Capobranco && mostraRuoli)
                                    {
                                        <span title="Capobranco">👑</span>
                                    }
                                </span>
                            }
                        </div>

                        @if (Gufati.Count > 0)
                        {
                            <div class="info-banner">
                                🦉 Al ballottaggio oggi: <strong>@NomiGufati</strong>.
                            </div>
                        }

                        <div class="stage-actions">
                            <button type="button" class="btn btn-primary" @onclick="ApriVoto">Apri il voto</button>
                        </div>
                    </div>
                }
                else if (p.Fase == FasePartita.Voto)
                {
                    <div class="card vote-card">
                        <div class="stage-head">
                            <div class="stage-icon">🗳️</div>
                            <div>
                                <p class="eyebrow">Turno @p.Turno</p>
                                <h2>Chi va al rogo?</h2>
                                <p class="muted">I telefoni votano in tempo reale. Tu chiudi quando siete pronti.</p>
                            </div>
                        </div>

                        @if (Gufati.Count > 0)
                        {
                            <div class="info-banner">
                                🦉 Candidati dal Gufo: <strong>@NomiGufati</strong>.
                            </div>
                        }

                        <div class="vote-live">
                            <div class="vote-progress">
                                <span>@VotantiVoto / @p.TotaleVivi hanno votato</span>
                                <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@p.TotaleVivi" aria-valuenow="@VotantiVoto">
                                    <div style="width: @Percentuale(VotantiVoto, p.TotaleVivi)%"></div>
                                </div>
                            </div>

                            <VoteTally Conteggi="ConteggiVoto"
                                       NonVotanti="NonVotantiVoto"
                                       Votanti="@VotantiVoto"
                                       Vivi="@p.TotaleVivi" />
                        </div>

                        @if (stanza.VotoPareggio)
                        {
                            <div class="tie-panel">
                                <strong>Pareggio: scegli chi va al rogo</strong>
                                <div class="tie-actions">
                                    @foreach (var id in stanza.CandidatiPareggio)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => ChiudiVoto(id)">
                                            @p.NomeDi(id)
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="host-vote-actions">
                                <button type="button" class="btn btn-primary" @onclick="() => ChiudiVoto(null)">
                                    Chiudi il voto
                                </button>
                            </div>

                            <div class="force-vote">
                                <p class="muted small">
                                    Se un telefono non riesce a votare, puoi forzare il rogo.
                                    Scegli un giocatore vivo e conferma.
                                </p>
                                <PlayerPicker Giocatori="GiocatoriVivi"
                                              SelezionatoId="@selezionatoId"
                                              OnSeleziona="Seleziona"
                                              MostraRuoli="mostraRuoli" />
                                <button type="button" class="btn btn-ghost" @onclick="() => ChiudiVoto(selezionatoId)" disabled="@(selezionatoId == null)">
                                    Forza il rogo
                                </button>
                            </div>
                        }
                    </div>
                }
                else if (p.Fase == FasePartita.Ballottaggio)
                {
                    <div class="card ballot-card">
                        <div class="stage-head">
                            <div class="stage-icon">⚖️</div>
                            <div>
                                <p class="eyebrow">Turno @p.Turno</p>
                                <h2>Ballottaggio</h2>
                                <p class="muted">I telefoni scelgono tra i candidati. Chiudi quando siete pronti.</p>
                            </div>
                        </div>

                        <div class="ballot-candidates">
                            @foreach (var g in GiocatoriBallottaggio)
                            {
                                <span class="candidate-chip" style="--accent: @Ruoli.Info(g.Ruolo).Accento">
                                    @Ruoli.Info(g.Ruolo).Icona @g.Nome
                                </span>
                            }
                        </div>

                        <div class="vote-live">
                            <div class="vote-progress">
                                <span>@VotantiBallottaggio / @p.TotaleVivi hanno votato</span>
                                <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@p.TotaleVivi" aria-valuenow="@VotantiBallottaggio">
                                    <div style="width: @Percentuale(VotantiBallottaggio, p.TotaleVivi)%"></div>
                                </div>
                            </div>

                            <VoteTally Conteggi="ConteggiBallottaggio"
                                       NonVotanti="NonVotantiBallottaggio"
                                       Votanti="@VotantiBallottaggio"
                                       Vivi="@p.TotaleVivi" />
                        </div>

                        @if (stanza.BallottaggioPareggio)
                        {
                            <div class="tie-panel">
                                <strong>Pareggio: scegli chi va al rogo</strong>
                                <div class="tie-actions">
                                    @foreach (var id in stanza.CandidatiPareggioBallottaggio)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => ChiudiBallottaggio(id)">
                                            @p.NomeDi(id)
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="host-vote-actions">
                                <button type="button" class="btn btn-primary" @onclick="() => ChiudiBallottaggio(null)">
                                    Chiudi il ballottaggio
                                </button>
                            </div>

                            <div class="force-vote">
                                <p class="muted small">Forza la scelta tra i candidati, se serve.</p>
                                <PlayerPicker Giocatori="GiocatoriBallottaggio"
                                              SelezionatoId="@selezionatoId"
                                              OnSeleziona="Seleziona"
                                              MostraRuoli="mostraRuoli" />
                                <button type="button" class="btn btn-ghost" @onclick="() => ChiudiBallottaggio(selezionatoId)" disabled="@(selezionatoId == null)">
                                    Forza il rogo
                                </button>
                            </div>
                        }
                    </div>
                }
                else if (p.Fase == FasePartita.Esecuzione)
                {
                    <div class="card">
                        <div class="stage-head">
                            <div class="stage-icon">🔥</div>
                            <div>
                                <p class="eyebrow">Turno @p.Turno</p>
                                <h2>Il rogo è concluso</h2>
                                <p class="muted">Annuncia il ruolo del condannato, poi prepara la prossima notte.</p>
                            </div>
                        </div>

                        @if (UltimoRogo is { } rogo)
                        {
                            <div class="execution-card" style="--accent: @Ruoli.Info(rogo.Ruolo).Accento">
                                <span class="avatar">@rogo.Iniziali</span>
                                <div>
                                    <p class="eyebrow">Condannato</p>
                                    <h3>@rogo.Nome</h3>
                                    <span class="role-chip" style="--accent: @Ruoli.Info(rogo.Ruolo).Accento">
                                        @Ruoli.Info(rogo.Ruolo).Icona @Ruoli.Nome(rogo.Ruolo)
                                    </span>
                                </div>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => ApriRivelazione(rogo)">Rivela ruolo</button>
                            </div>
                        }
                        else
                        {
                            <p class="muted">Nessun condannato registrato per questo turno.</p>
                        }

                        <label class="toggle">
                            <input type="checkbox"
                                   checked="@stanza.RivelaRuoloRogo"
                                   @onchange="OnRivelaRuoloRogoChanged" />
                            <span>Rivela ai telefoni il ruolo del condannato</span>
                        </label>

                        <div class="alive-strip">
                            @foreach (var g in GiocatoriVivi)
                            {
                                <span class="alive-chip" style="--accent: @Ruoli.Info(g.Ruolo).Accento">
                                    <span class="avatar">@g.Iniziali</span>
                                    @g.Nome
                                </span>
                            }
                        </div>

                        <div class="stage-actions">
                            <button type="button" class="btn btn-primary" @onclick="ProssimaNotte">Cala la notte</button>
                        </div>
                    </div>
                }
                else if (p.Fase == FasePartita.Finita)
                {
                    <section class="winner-panel @Testi.ClasseVittoria(p.Esito)">
                        <div class="winner-icon">@Testi.IconaVittoria(p.Esito)</div>
                        <p class="eyebrow">Partita conclusa</p>
                        <h2>@Testi.TitoloVittoria(p.Esito)</h2>
                        <p>@Testi.SottotitoloVittoria(p.Esito)</p>
                        <div class="winner-stats">
                            <div><strong>@p.Turno</strong><span>turni</span></div>
                            <div><strong>@p.Giocatori.Count</strong><span>giocatori</span></div>
                            <div><strong>@p.TotaleVivi</strong><span>superstiti</span></div>
                        </div>
                        <div class="winner-actions">
                            <button type="button" class="btn btn-primary" @onclick="ChiudiStanza">Chiudi la stanza</button>
                            <button type="button" class="btn btn-ghost" @onclick="Esporta">Esporta riepilogo</button>
                        </div>
                    </section>

                    <div class="card">
                        <div class="card-head compact">
                            <h2>Riepilogo finale</h2>
                            <span class="muted">@p.TotaleVivi vivi / @p.Giocatori.Count</span>
                        </div>
                        <div class="final-grid">
                            @foreach (var g in p.Giocatori.OrderByDescending(x => x.Vivo).ThenBy(x => x.Nome))
                            {
                                <div class="final-player @(g.Vivo ? "" : "dead")" style="--accent: @Ruoli.Info(g.Ruolo).Accento">
                                    <span class="avatar">@g.Iniziali</span>
                                    <div class="final-player-body">
                                        <span class="final-player-name">@g.Nome @(g.Vivo ? "" : "✝")</span>
                                        <span class="role-chip" style="--accent: @Ruoli.Info(g.Ruolo).Accento">
                                            @Ruoli.Info(g.Ruolo).Icona @Ruoli.Nome(g.Ruolo)
                                        </span>
                                    </div>
                                    @if (g.Capobranco)
                                    {
                                        <span title="Capobranco">👑</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </main>

            <aside class="game-aside">
                @if (stanza.Avviata)
                {
                    <TimerCountdown @key="TimerKey"
                                    Etichetta="@EtichettaTimer"
                                    DurataIniziale="@p.TimerSecondi"
                                    OnDurataCambiata="AggiornaDurataTimer" />
                }

                <div class="card players-card">
                    <div class="card-head compact">
                        <h2>Giocatori</h2>
                        <span class="muted">@p.TotaleVivi vivi / @p.Giocatori.Count</span>
                    </div>

                    <div class="player-list">
                        @foreach (var g in p.Giocatori.OrderByDescending(x => x.Vivo).ThenBy(x => x.Nome))
                        {
                            <button type="button" class="player-row @(g.Vivo ? "" : "dead")" @onclick="() => ApriRivelazione(g)">
                                <span class="avatar" style="--accent: @Ruoli.Info(g.Ruolo).Accento">@g.Iniziali</span>
                                <span class="player-row-body">
                                    <span class="player-row-name">@g.Nome</span>
                                    @if (mostraRuoli)
                                    {
                                        <span class="role-chip" style="--accent: @Ruoli.Info(g.Ruolo).Accento">
                                            @Ruoli.Info(g.Ruolo).Icona @Ruoli.Nome(g.Ruolo)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="player-row-hint">@(g.Vivo ? "tocca per rivelare" : "fuori gioco")</span>
                                    }
                                </span>
                                <span class="player-row-badges">
                                    @if (Connesso(g.Id))
                                    {
                                        <span title="Telefono collegato">📱</span>
                                    }
                                    @if (mostraRuoli && g.Capobranco)
                                    {
                                        <span title="Capobranco">👑</span>
                                    }
                                    @if (mostraRuoli && g.Trasformato)
                                    {
                                        <span title="Trasformato">🎭</span>
                                    }
                                    @if (mostraRuoli && g.DiavoloSbranato)
                                    {
                                        <span title="Diavolo sbranato">😈</span>
                                    }
                                    @if (mostraRuoli && g.TrappolaInCooldown)
                                    {
                                        <span title="Trappola in cooldown">🪤</span>
                                    }
                                    @if (!g.Vivo)
                                    {
                                        <span title="Morto">✝</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>

                    <button type="button" class="btn btn-ghost btn-block btn-sm" @onclick="ApriModaleRuoli">
                        Rivela ruoli ai giocatori
                    </button>
                </div>

                <div class="card room-card">
                    <div class="card-head compact">
                        <h2>Stanza</h2>
                        <span class="pill">@stanza.Codice</span>
                    </div>

                    <p class="muted small">Link per i telefoni</p>
                    <code class="room-link">@JoinUrl</code>

                    <div class="room-actions">
                        <button type="button" class="btn btn-ghost btn-block btn-sm" @onclick="CopiaLink">Copia link</button>
                        <button type="button" class="btn btn-ghost btn-block btn-sm" @onclick="Esporta">Esporta JSON</button>
                        <button type="button" class="btn btn-danger btn-block btn-sm" @onclick="ChiudiStanza">Chiudi stanza</button>
                    </div>

                    <p class="micro">La stanza vive sul server. Se lo riavvii, esporta prima il JSON.</p>
                </div>

                <div class="card log-card">
                    <div class="card-head compact">
                        <h2>Diario</h2>
                        <span class="muted">@p.Log.Count voci</span>
                    </div>

                    <div class="log-filters">
                        @foreach (var f in FiltriLog)
                        {
                            <button type="button" class="log-filter @(filtroLog == f.Chiave ? "active" : "")"
                                    @onclick="() => ImpostaFiltro(f.Chiave)">
                                @f.Etichetta
                            </button>
                        }
                    </div>

                    <div class="log-list">
                        @if (!LogFiltrato.Any())
                        {
                            <p class="empty-state">Nessuna voce per questo filtro.</p>
                        }
                        @foreach (var voce in LogFiltrato)
                        {
                            <div class="log-entry @ClasseLog(voce.Tipo)">
                                <span class="log-turn">T@(voce.Turno)</span>
                                <div>
                                    <p>@voce.Testo</p>
                                    <span class="log-meta">@Testi.FaseBreve(voce.Fase) · @voce.Ora.ToString("HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </aside>
        </div>
    </div>

    @if (mostraModaleRuolo)
    {
        <div class="modal-backdrop" @onclick="ChiudiModale">
            <div class="modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Rivelazione ruoli">
                <div class="modal-head">
                    <div>
                        <p class="eyebrow">Solo narratore</p>
                        <h2>Rivelazione ruoli</h2>
                    </div>
                    <button type="button" class="icon-btn" @onclick="ChiudiModale" aria-label="Chiudi">✕</button>
                </div>

                @if (giocatoreRivelato == null)
                {
                    <p class="muted">Passa il dispositivo a un giocatore e tocca il suo nome. Poi chiedigli di nascondere lo schermo.</p>
                    <div class="reveal-list">
                        @foreach (var g in p.Giocatori)
                        {
                            <button type="button" class="reveal-player @(Rivelato(g) ? "revealed" : "")" @onclick="() => RivelaGiocatore(g)">
                                <span class="avatar">@g.Iniziali</span>
                                <span>@g.Nome</span>
                                <span>@(Rivelato(g) ? "✓ visto" : "Rivela")</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    var info = Ruoli.Info(giocatoreRivelato.Ruolo);
                    <div class="reveal-card" style="--accent: @info.Accento">
                        <span class="reveal-icon">@info.Icona</span>
                        <p class="eyebrow">@giocatoreRivelato.Nome</p>
                        <h2>@info.Nome</h2>
                        <span class="alignment @(info.Buono ? "good" : "evil")">@Ruoli.Fazione(giocatoreRivelato.Ruolo)</span>
                        <p>@info.Descrizione</p>
                        @if (giocatoreRivelato.Capobranco)
                        {
                            <span class="badge">👑 Capobranco</span>
                        }
                        @if (giocatoreRivelato.Trasformato && giocatoreRivelato.RuoloIniziale is { } iniziale)
                        {
                            <span class="badge">🎭 Era @Ruoli.Nome(iniziale)</span>
                        }
                        <button type="button" class="btn btn-primary" @onclick="ChiudiRivelazione">Nascondi e torna alla lista</button>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private static readonly FasePartita[] Fasi =
    {
        FasePartita.NotteIntro,
        FasePartita.Notte,
        FasePartita.Alba,
        FasePartita.Giorno,
        FasePartita.Voto,
        FasePartita.Ballottaggio,
        FasePartita.Esecuzione,
        FasePartita.Finita
    };

    private static readonly (string Chiave, string Etichetta)[] FiltriLog =
    {
        ("tutto", "Tutto"),
        ("notte", "Notte"),
        ("voti", "Voti"),
        ("morti", "Morti")
    };

    [Parameter] public string Codice { get; set; } = "";
    [SupplyParameterFromQuery(Name = "h")] public string? HostTokenQuery { get; set; }

    private Stanza? stanza;
    private string? hostToken;
    private bool caricamento = true;
    private bool accessoNegato;
    private bool sottoscritto;
    private bool mostraRuoli = true;
    private bool mostraModaleRuolo;
    private Giocatore? giocatoreRivelato;
    private readonly HashSet<string> ruoliRivelati = new();
    private string? selezionatoId;
    private string? errore;
    private string? avviso;
    private string filtroLog = "tutto";
    private int timerReset;
    private int logCountPrecedente = -1;
    private List<PostoStanza> posti = new();

    private Partita? P => stanza?.Partita;

    private string TitoloPagina => P == null ? "Partita" : $"Turno {P.Turno}";

    private string TitoloFase
    {
        get
        {
            if (P == null) return "Partita";
            return P.Fase switch
            {
                FasePartita.NotteIntro => stanza?.Avviata == true ? "Preparazione della notte" : "Lobby",
                FasePartita.Notte => $"Notte {P.Turno}",
                FasePartita.Alba => "Alba",
                FasePartita.Giorno => "Discussione",
                FasePartita.Voto => "Votazione",
                FasePartita.Ballottaggio => "Ballottaggio",
                FasePartita.Esecuzione => "Fine del turno",
                FasePartita.Finita => Testi.TitoloVittoria(P.Esito),
                _ => "Partita"
            };
        }
    }

    private string SottotitoloFase
    {
        get
        {
            if (P == null) return "";
            if (stanza?.Avviata == false) return "Aspetta i telefoni, poi avvia la partita.";
            return P.Fase switch
            {
                FasePartita.NotteIntro => "Rivela i ruoli, poi chiama il villaggio a dormire.",
                FasePartita.Notte => "Segui i passi in ordine di priorità. I giocatori agiscono dal telefono.",
                FasePartita.Alba => "Annuncia i morti e gli eventi pubblici.",
                FasePartita.Giorno => "Il villaggio discute. Usa il timer per tenere il ritmo.",
                FasePartita.Voto => "Raccogli i voti dei telefoni e chiudi quando siete pronti.",
                FasePartita.Ballottaggio => "Scegli tra i candidati mandati al ballottaggio.",
                FasePartita.Esecuzione => "Il rogo è concluso. Prepara la prossima notte.",
                FasePartita.Finita => Testi.SottotitoloVittoria(P.Esito),
                _ => ""
            };
        }
    }

    private string EtichettaTimer
    {
        get
        {
            if (P == null) return "Timer";
            return P.Fase switch
            {
                FasePartita.Notte => "Azioni notturne",
                FasePartita.Giorno => "Discussione",
                FasePartita.Voto => "Votazione",
                FasePartita.Ballottaggio => "Ballottaggio",
                _ => "Timer"
            };
        }
    }

    private string TimerKey => $"{stanza?.Codice}-{P?.Turno}-{P?.Fase}-{timerReset}";

    private string JoinUrl => stanza == null ? "" : Rete.UrlEntra(stanza.Codice);

    private int PassiTotali => P?.PassiNotte.Count ?? 0;

    private int PassiCompletati => P?.PassiNotte.Count(x => x.Completato) ?? 0;

    private int PercentualePassi => Percentuale(PassiCompletati, PassiTotali);

    private RisultatoNotte? Risultato => P?.RisultatoNotte;

    private Giocatore? UltimoRogo => P?.Giocatore(P.UltimoRogoId);

    private IEnumerable<IGrouping<Ruolo, Giocatore>> Composizione =>
        P?.Giocatori.GroupBy(g => g.Ruolo) ?? Enumerable.Empty<IGrouping<Ruolo, Giocatore>>();

    private string ComposizioneTesto
    {
        get
        {
            if (P == null) return "";
            return string.Join(" · ", P.Giocatori
                .GroupBy(g => g.Ruolo)
                .OrderBy(g => Ruoli.Info(g.Key).Priorita)
                .Select(g => $"{Ruoli.Nome(g.Key)} x{g.Count()}"));
        }
    }

    private List<Giocatore> GiocatoriVivi =>
        P?.Vivi.OrderBy(g => g.Nome).ToList() ?? new();

    private List<Giocatore> GiocatoriPasso
    {
        get
        {
            if (P?.PassoCorrente is not { } passo) return new();
            return passo.OpzioniIds
                .Select(id => P.Giocatore(id))
                .OfType<Giocatore>()
                .ToList();
        }
    }

    private List<Giocatore> GiocatoriBallottaggio
    {
        get
        {
            if (P == null) return new();
            return P.BallottaggioIds
                .Select(id => P.Giocatore(id))
                .OfType<Giocatore>()
                .Where(g => g.Vivo)
                .ToList();
        }
    }

    private List<Giocatore> Gufati =>
        P?.Fase is FasePartita.Alba or FasePartita.Giorno or FasePartita.Voto
            ? GiocatoriBallottaggio
            : new List<Giocatore>();

    private string NomiGufati => string.Join(", ", Gufati.Select(g => g.Nome));

    private List<Giocatore> MortiNotte
    {
        get
        {
            if (P?.RisultatoNotte == null) return new();
            return P.RisultatoNotte.MortiIds
                .Select(id => P.Giocatore(id))
                .OfType<Giocatore>()
                .ToList();
        }
    }

    private IEnumerable<EventoNotte> EventiPubblici =>
        P?.RisultatoNotte?.Eventi.Where(e => !e.Riservato) ?? Enumerable.Empty<EventoNotte>();

    private IEnumerable<EventoNotte> EventiRiservati =>
        P?.RisultatoNotte?.Eventi.Where(e => e.Riservato) ?? Enumerable.Empty<EventoNotte>();

    private IEnumerable<VoceLog> LogFiltrato
    {
        get
        {
            if (P == null) return Enumerable.Empty<VoceLog>();

            IEnumerable<VoceLog> voci = P.Log;
            voci = filtroLog switch
            {
                "notte" => voci.Where(v => v.Tipo is TipoLog.Notte or TipoLog.Potere),
                "voti" => voci.Where(v => v.Tipo == TipoLog.Voto),
                "morti" => voci.Where(v => v.Tipo == TipoLog.Morte),
                _ => voci
            };

            return voci.TakeLast(250);
        }
    }

    private int VotantiVoto => stanza?.SnapshotVoti().Count ?? 0;

    private int VotantiBallottaggio => stanza?.SnapshotVotiBallottaggio().Count ?? 0;

    private List<ConteggioVoto> ConteggiVoto => CalcolaConteggi(stanza?.SnapshotVoti());

    private List<ConteggioVoto> ConteggiBallottaggio => CalcolaConteggi(stanza?.SnapshotVotiBallottaggio());

    private List<string> NonVotantiVoto => CalcolaNonVotanti(stanza?.SnapshotVoti());

    private List<string> NonVotantiBallottaggio => CalcolaNonVotanti(stanza?.SnapshotVotiBallottaggio());

    protected override void OnInitialized()
    {
        stanza = Stanze.Ottieni(Codice);
        if (stanza == null)
            caricamento = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (stanza != null)
            {
                hostToken = HostTokenQuery;

                if (string.IsNullOrWhiteSpace(hostToken))
                {
                    var sessione = await Sessioni.TrovaAsync(Codice, TipoSessione.Host);
                    hostToken = sessione?.Token;
                }

                if (string.IsNullOrWhiteSpace(hostToken) || !Stanze.ValidaHost(stanza, hostToken))
                {
                    accessoNegato = true;
                    caricamento = false;
                    StateHasChanged();
                    return;
                }

                await Sessioni.SalvaAsync(new SessioneBrowser
                {
                    Codice = Codice,
                    Tipo = TipoSessione.Host,
                    Token = hostToken
                });

                Stanze.Sottoscrivi(Codice, OnStanzaAggiornata);
                sottoscritto = true;
                AggiornaVista();
            }

            caricamento = false;
            StateHasChanged();
        }

        if (P != null && P.Log.Count != logCountPrecedente)
        {
            logCountPrecedente = P.Log.Count;
            try
            {
                await JS.InvokeVoidAsync("lupusStorage.scrollLog");
            }
            catch (JSDisconnectedException)
            {
                // Il circuito è già chiuso: nessun problema.
            }
        }
    }

    private void AggiornaVista()
    {
        if (stanza == null) return;

        var corrente = Stanze.Ottieni(stanza.Codice);
        if (corrente == null)
        {
            stanza = null;
            return;
        }

        stanza = corrente;
        posti = Stanze.PostiPubblici(stanza).ToList();
    }

    private async Task OnStanzaAggiornata()
    {
        await InvokeAsync(() =>
        {
            AggiornaVista();
            StateHasChanged();
        });
    }

    private string ClasseFase(FasePartita fase)
    {
        if (P == null) return "todo";

        var corrente = Array.IndexOf(Fasi, P.Fase);
        var indice = Array.IndexOf(Fasi, fase);

        if (indice == corrente) return "current";
        return indice < corrente ? "done" : "todo";
    }

    private static string ClasseLog(TipoLog tipo) => tipo switch
    {
        TipoLog.Notte => "log-notte",
        TipoLog.Potere => "log-potere",
        TipoLog.Morte => "log-morte",
        TipoLog.Voto => "log-voto",
        TipoLog.Trasformazione => "log-trasformazione",
        TipoLog.Vittoria => "log-vittoria",
        TipoLog.Configurazione => "log-configurazione",
        _ => "log-info"
    };

    private static string IconaPasso(PassoNotte passo)
    {
        if (passo.Tipo == TipoPasso.Capobranco) return "👑";

        return passo.Potere switch
        {
            Potere.Lupo or Potere.ImputatoLupo => "🐺",
            Potere.Guardiano or Potere.ImputatoGuardiano => "🛡️",
            Potere.Annullatore => "🚫",
            Potere.Becchino => "⚰️",
            Potere.Veggente or Potere.ImputatoVeggente => "🔮",
            Potere.Puttana or Potere.ImputatoPuttana => "💃",
            Potere.Spia or Potere.ImputatoSpia => "🕵️",
            Potere.Cacciatore or Potere.ImputatoCacciatore => "🪤",
            Potere.Gufo or Potere.ImputatoGufo => "🦉",
            Potere.Copione or Potere.Copione2 => "🎭",
            _ => "✨"
        };
    }

    private string AttoreBreve(PassoNotte passo)
    {
        if (P == null) return "?";
        if (passo.Tipo == TipoPasso.Capobranco) return "tutti i lupi";
        if (passo.Potere == Potere.Lupo) return "il branco";
        return P.NomeDi(passo.AttoreId);
    }

    /// <summary>"Tocca a Giocatore 2", ma "Tocca al branco".</summary>
    private string ToccaA(PassoNotte passo)
    {
        if (P == null) return "Tocca a ?";
        if (passo.Tipo == TipoPasso.Capobranco) return "Toccano a tutti i lupi";
        if (passo.Potere == Potere.Lupo) return "Tocca al branco";
        return $"Tocca a {P.NomeDi(passo.AttoreId)}";
    }

    private string AttorePasso(PassoNotte passo)
    {
        if (passo.Tipo == TipoPasso.Capobranco)
            return "Elezioni del capobranco: decidono tutti i lupi.";

        if (passo.Potere == Potere.Lupo)
            return "Azione del branco.";

        return $"Azione di {AttoreBreve(passo)}.";
    }

    private bool Connesso(string giocatoreId) =>
        posti.FirstOrDefault(p => p.GiocatoreId == giocatoreId)?.Occupato == true;

    private bool Rivelato(Giocatore g) => ruoliRivelati.Contains(g.Id);

    private void ToggleMostraRuoli() => mostraRuoli = !mostraRuoli;

    private void ImpostaFiltro(string chiave) => filtroLog = chiave;

    private void ApriModaleRuoli()
    {
        giocatoreRivelato = null;
        mostraModaleRuolo = true;
    }

    private void ApriRivelazione(Giocatore g)
    {
        ruoliRivelati.Add(g.Id);
        giocatoreRivelato = g;
        mostraModaleRuolo = true;
    }

    private void RivelaGiocatore(Giocatore g)
    {
        ruoliRivelati.Add(g.Id);
        giocatoreRivelato = g;
    }

    private void ChiudiRivelazione() => giocatoreRivelato = null;

    private void ChiudiModale()
    {
        mostraModaleRuolo = false;
        giocatoreRivelato = null;
    }

    private Task Seleziona(string id)
    {
        selezionatoId = id;
        errore = null;
        return Task.CompletedTask;
    }

    private async Task AvviaStanza()
    {
        await EseguiHost(
            () => Stanze.AvviaAsync(stanza!, hostToken!),
            "Partita avviata: i telefoni mostrano i ruoli.");
    }

    private async Task IniziaNotte()
    {
        selezionatoId = null;
        await EseguiHost(
            () => Stanze.IniziaNotteAsync(stanza!, hostToken!),
            "La notte è calata.");
    }

    private async Task RisolviNotte()
    {
        selezionatoId = null;
        await EseguiHost(
            () => Stanze.RisolviNotteAsync(stanza!, hostToken!),
            "Notte risolta.");
    }

    private async Task VaiAlGiorno()
    {
        selezionatoId = null;
        await EseguiHost(
            () => Stanze.VaiAlGiornoAsync(stanza!, hostToken!),
            "Il villaggio è sveglio.");
    }

    private async Task ApriVoto()
    {
        selezionatoId = null;
        await EseguiHost(
            () => Stanze.ApriVotoAsync(stanza!, hostToken!),
            "Voto aperto: i telefoni possono votare.");
    }

    private async Task ProssimaNotte()
    {
        selezionatoId = null;
        timerReset++;
        await EseguiHost(
            () => Stanze.ProssimaNotteAsync(stanza!, hostToken!),
            "Turno successivo.");
    }

    private async Task EseguiPassoNarratore()
    {
        if (P?.PassoCorrente is not { } passo) return;

        if (string.IsNullOrWhiteSpace(selezionatoId))
        {
            errore = "Scegli un giocatore prima di confermare.";
            return;
        }

        var bersaglio = selezionatoId;
        await EseguiHost(
            () => Stanze.EseguiPassoNarratoreAsync(stanza!, hostToken!, passo.Id, bersaglio),
            "Azione registrata.");

        selezionatoId = null;
    }

