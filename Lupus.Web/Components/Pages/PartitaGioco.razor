    private static bool LeggiBool(object? valore) => valore switch
    {
        bool b => b,
        string s when bool.TryParse(s, out var parsed) => parsed,
        _ => false
    };

    private async Task CopiaLink()
    {
        var ok = await Archivio.CopiaAsync(JoinUrl);
        avviso = ok ? "Link copiato negli appunti." : "Copia non riuscita: seleziona il link manualmente.";
    }

    private async Task Esporta()
    {
        if (P == null) return;
        await Archivio.ScaricaAsync(P);
        avviso = "File JSON scaricato.";
    }

    private async Task ChiudiStanza()
    {
        if (stanza == null) return;

        var conferma = await Archivio.ConfermaAsync(
            "Vuoi chiudere la stanza? I telefoni verranno disconnessi e la partita non sarà più raggiungibile.");

        if (!conferma) return;

        await Stanze.AbbandonaAsync(stanza, hostToken!);
        await Sessioni.RimuoviAsync(stanza.Codice, TipoSessione.Host);
        stanza = null;
        Nav.NavigateTo("/");
    }

    private async Task EseguiHost(Func<Task<EsitoPasso>> azione, string? messaggio = null)
    {
        errore = null;

        try
        {
            var esito = await azione();
            if (!esito.Ok)
                errore = esito.Errore;
            else if (!string.IsNullOrWhiteSpace(messaggio))
                avviso = messaggio;
        }
        catch (Exception ex)
        {
            errore = ex.Message;
        }
        finally
        {
            AggiornaVista();
            StateHasChanged();
        }
    }

    private List<ConteggioVoto> CalcolaConteggi(IReadOnlyDictionary<string, string>? voti)
    {
        if (P == null || voti == null || voti.Count == 0) return new();

        return voti
            .GroupBy(kv => kv.Value)
            .Select(g => new ConteggioVoto(
                g.Key,
                P.NomeDi(g.Key),
                g.Count(),
                g.Select(kv => P.NomeDi(kv.Key)).OrderBy(n => n).ToList()))
            .OrderByDescending(c => c.Voti)
            .ThenBy(c => c.Nome)
            .ToList();
    }

    private List<string> CalcolaNonVotanti(IReadOnlyDictionary<string, string>? voti)
    {
        if (P == null) return new();
        var espressi = voti ?? new Dictionary<string, string>();

        return P.Vivi
            .Where(g => !espressi.ContainsKey(g.Id))
            .Select(g => g.Nome)
            .OrderBy(n => n)
            .ToList();
    }

    private static int Percentuale(int valore, int totale) =>
        totale <= 0 ? 0 : (int)Math.Round(100.0 * valore / totale);

    public void Dispose()
    {
        if (sottoscritto)
            Stanze.AnnullaSottoscrizione(Codice, OnStanzaAggiornata);
    }
